# Local application settings
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# PostgreSQL
DATABASE_URL=postgres://commerce:commerce_local_password@127.0.0.1:5432/commerce_integration
PG_POOL_MAX=5

# Supplier connectors
# External integrations are disabled by default. Enable only after adding credentials.
ZENDROP_MCP_URL=https://app.zendrop.com/mcp/v1
ZENDROP_ACCESS_TOKEN=
ZENDROP_ENABLED=false

CJ_API_BASE_URL=https://developers.cjdropshipping.com
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_WEBHOOK_SECRET=
CJ_ENABLED=false
CJ_US_COUNTRY_CODE=US
CJ_VERIFIED_WAREHOUSE_ONLY=true

# Commerce channels
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_VERSION=2025-01
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=

TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=
TIKTOK_SHOP_WEBHOOK_SECRET=
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_TRACKING_SLA_HOURS=24
TIKTOK_SLA_ESCALATE_HOURS=12

WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
WALMART_CHANNEL_TYPE=
WALMART_API_BASE_URL=https://sandbox.walmartapis.com
WALMART_WEBHOOK_SECRET=

# Optional listing enrichment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
LLM_PROVIDER=none

# Catalog and channel policy
REQUIRE_US_ORIGIN=true
MIN_TRANSIT_DAYS=3
MAX_TRANSIT_DAYS=5
MAX_TIKTOK_TOTAL_DAYS=6
INVENTORY_SYNC_CRON=0 */2 * * *
SLA_WATCH_CRON=*/10 * * * *
MARKUP_PERCENT=2.2
DEFAULT_CURRENCY=USD
